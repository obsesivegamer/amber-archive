+    # -wal and -shm next to the database. The reader user has to be the
+    # ingest user, and the directory has to be a Linux filesystem.
+    # Each request opens its own connection.
+    uri = "file:{}?mode=ro".format(quote(str(DB_PATH), safe="/:"))
     try:
